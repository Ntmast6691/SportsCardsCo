function showToast(msg){
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(()=> t.classList.remove('show'), 2400);
}

function photoKey(id){ return 'photo:' + id; }

async function loadCards(){
  const storageAvailable = !!window.storage;
  if(!storageAvailable){
    showToast("Stockage indisponible : tes ajouts ne seront pas conservés après fermeture.");
  }

  cards = JSON.parse(JSON.stringify(seed));

  if(storageAvailable){
    try{
      const result = await window.storage.get(META_KEY, false);
      if(result && result.value){
        cards = JSON.parse(result.value);
      }
    }catch(e){
      // pas de données existantes, on reste sur le seed
    }
  }

  // Ajoute les cartes de la wishlist PSG et la liste des Français en NBA
  // si elles ne sont pas déjà présentes. Toujours en mémoire, stockage ou pas.
  for(const wishCard of [...wishlistSeed, ...frenchNbaSeed]){
    if(!cards.find(c => c.id === wishCard.id)){
      cards.push({ ...wishCard });
    }
  }

  // Marque les cartes ayant une photo embarquée. L'affichage utilise
  // directement seedPhotos (voir loadPhotoInto), donc ceci ne dépend pas du stockage.
  for(const id of Object.keys(seedPhotos)){
    const card = cards.find(c => c.id === id);
    if(card) card.hasPhoto = true;
  }

  // On affiche tout de suite, sans attendre la sauvegarde en arrière-plan.
  render();

  // Sauvegarde en arrière-plan (best effort, ne bloque jamais l'affichage).
  if(storageAvailable){
    for(const [id, dataUrl] of Object.entries(seedPhotos)){
      window.storage.set(photoKey(id), dataUrl, false).catch(()=>{});
    }
    persistMeta().catch(()=>{});
  }
}

async function persistMeta(){
  try{
    await window.storage.set(META_KEY, JSON.stringify(cards), false);
  }catch(e){
    showToast("Erreur de sauvegarde des données.");
  }
}

function euro(v){
  const n = parseFloat((v||'0').toString().replace(',','.'));
  if(isNaN(n)) return v || '—';
  return n.toFixed(0);
}

function escapeHtml(str){
  const div = document.createElement('div');
  div.textContent = str || '';
  return div.innerHTML;
}

function render(){
  const binder = document.getElementById('binder');
  const emptyState = document.getElementById('emptyState');
  const sportFilter = document.getElementById('filterSport').value;
  const autoFilter = document.getElementById('filterAuto').value;
  const q = document.getElementById('search').value.trim().toLowerCase();

  const viewCards = cards.filter(c => !!c.wishlist === (activeView === 'wishlist'));

  let filtered = viewCards.filter(c=>{
    if(sportFilter && c.sport !== sportFilter) return false;
    if(autoFilter === 'oui' && !c.auto) return false;
    if(autoFilter === 'non' && c.auto) return false;
    if(q && !c.player.toLowerCase().includes(q)) return false;
    return true;
  });

  binder.innerHTML = '';
  emptyState.style.display = viewCards.length === 0 ? 'block' : 'none';
  emptyState.querySelector('p').innerHTML = activeView === 'wishlist'
    ? "Ta liste de souhaits est vide.<br>Ajoute une carte que tu chasses."
    : "Ton classeur est vide pour l'instant.<br>Ajoute ta première carte pour commencer.";

  filtered.forEach(c=>{
    const slot = document.createElement('div');
    slot.className = 'slot' + (c.hasPhoto ? ' has-photo' : '');
    slot.innerHTML = `
      ${c.hasPhoto ? `<div class="photo-bg" id="bg-${c.id}"></div><div class="photo-scrim"></div>` : ''}
      <div class="top-row">
        <span class="badge sport">${c.sport || 'Football'}</span>
        <div style="display:flex; gap:4px; align-items:center;">
          ${c.auto ? '<span class="badge auto">AUTO</span>' : ''}
          ${c.wishlist ? '<span class="badge wish">SOUHAIT</span>' : ''}
          <button class="del" data-id="${c.id}" title="Supprimer">✕</button>
        </div>
      </div>
      <div class="body">
        <div class="player">${escapeHtml(c.player)}</div>
        <div class="team">${escapeHtml(c.team || '')}</div>
        <div class="setline"><b>${escapeHtml(c.set || 'Set inconnu')}</b></div>
        ${c.numbering ? `<div class="numbering">${escapeHtml(c.numbering)}</div>` : ''}
      </div>
      <div class="bottom-row" style="flex-direction:column; align-items:stretch; gap:4px;">
        <div style="display:flex; justify-content:space-between; align-items:flex-end;">
          <div class="value">${c.value ? euro(c.value) : '—'}<span class="cur">${c.value ? ' €' : ''}</span></div>
          <div class="cardnum">${escapeHtml(c.cardNum || '')}</div>
        </div>
        ${c.wishlist ? `<button class="move-btn" data-id="${c.id}">Trouvée → ajouter au classeur</button>` : ''}
      </div>
    `;
    slot.addEventListener('click', (e)=>{
      if(e.target.classList.contains('del') || e.target.classList.contains('move-btn')) return;
      openEdit(c.id);
    });
    binder.appendChild(slot);

    if(c.hasPhoto){
      loadPhotoInto(c.id);
    }
  });

  const addSlot = document.createElement('div');
  addSlot.className = 'slot add-slot';
  addSlot.innerHTML = `<div class="plus">+</div><div class="txt">Ajouter</div>`;
  addSlot.addEventListener('click', openAddModal);
  binder.appendChild(addSlot);

  document.querySelectorAll('.del').forEach(btn=>{
    btn.addEventListener('click', (e)=>{
      e.stopPropagation();
      deleteCard(btn.dataset.id);
    });
  });

  document.querySelectorAll('.move-btn').forEach(btn=>{
    btn.addEventListener('click', (e)=>{
      e.stopPropagation();
      moveToCollection(btn.dataset.id);
    });
  });

  renderStats();
}

async function moveToCollection(id){
  const card = cards.find(c=>c.id === id);
  if(!card) return;
  card.wishlist = false;
  await persistMeta();
  render();
  showToast(card.player + ' déplacée vers ta collection.');
}

async function loadPhotoInto(id){
  const el = document.getElementById('bg-' + id);
  if(!el) return;

  // Priorité aux photos embarquées directement dans le fichier (fiable, pas de dépendance au stockage)
  if(seedPhotos[id]){
    el.style.backgroundImage = `url(${seedPhotos[id]})`;
    return;
  }

  try{
    const result = await window.storage.get(photoKey(id), false);
    if(result && result.value){
      el.style.backgroundImage = `url(${result.value})`;
    }
  }catch(e){
    console.error('Photo introuvable pour', id, e);
  }
}

function renderStats(){
  const viewCards = cards.filter(c => !!c.wishlist === (activeView === 'wishlist'));
  const total = viewCards.length;
  const autoCount = viewCards.filter(c=>c.auto).length;
  const totalValue = viewCards.reduce((sum,c)=> sum + (parseFloat((c.value||'0').toString().replace(',','.')) || 0), 0);
  const valueLabel = activeView === 'wishlist' ? 'Budget total' : 'Valeur estimée';
  const stats = document.getElementById('stats');
  stats.innerHTML = `
    <div class="stat"><div class="num">${total}</div><div class="label">Cartes</div></div>
    <div class="stat"><div class="num">${autoCount}</div><div class="label">Autographiées</div></div>
    <div class="stat"><div class="num">${totalValue.toFixed(0)}€</div><div class="label">${valueLabel}</div></div>
  `;
}

function switchView(view){
  activeView = view;
  document.getElementById('tabCollection').classList.toggle('active', view === 'collection');
  document.getElementById('tabWishlist').classList.toggle('active', view === 'wishlist');
  render();
}

/* ---------- Dropzone / photo handling ---------- */
function renderDropzone(){
  const wrap = document.getElementById('dropzoneWrap');
  if(currentPhotoData){
    wrap.innerHTML = `
      <div class="preview-wrap">
        <img src="${currentPhotoData}" alt="Aperçu carte">
        <button type="button" class="preview-remove" id="removePhoto">✕</button>
      </div>
    `;
    document.getElementById('removePhoto').addEventListener('click', ()=>{
      currentPhotoData = null;
      renderDropzone();
    });
  } else {
    wrap.innerHTML = `
      <div class="dropzone" id="dropzone">
        <div class="icon">📷</div>
        <div class="txt"><b>Clique</b> ou glisse une photo ici</div>
        <input type="file" id="photoInput" accept="image/*">
      </div>
    `;
    const dz = document.getElementById('dropzone');
    const input = document.getElementById('photoInput');
    input.addEventListener('change', (e)=>{
      if(e.target.files[0]) handleFile(e.target.files[0]);
    });
    dz.addEventListener('dragover', (e)=>{ e.preventDefault(); dz.classList.add('drag'); });
    dz.addEventListener('dragleave', ()=> dz.classList.remove('drag'));
    dz.addEventListener('drop', (e)=>{
      e.preventDefault();
      dz.classList.remove('drag');
      if(e.dataTransfer.files[0]) handleFile(e.dataTransfer.files[0]);
    });
  }
}

function handleFile(file){
  if(!file.type.startsWith('image/')){
    showToast('Merci de choisir un fichier image.');
    return;
  }
  const reader = new FileReader();
  reader.onload = (e)=>{
    compressImage(e.target.result, (compressed)=>{
      currentPhotoData = compressed;
      renderDropzone();
    });
  };
  reader.readAsDataURL(file);
}

function compressImage(dataUrl, callback){
  const img = new Image();
  img.onload = ()=>{
    const maxDim = 700;
    let { width, height } = img;
    if(width > height && width > maxDim){
      height = Math.round(height * (maxDim / width));
      width = maxDim;
    } else if(height > maxDim){
      width = Math.round(width * (maxDim / height));
      height = maxDim;
    }
    const canvas = document.createElement('canvas');
    canvas.width = width;
    canvas.height = height;
    const ctx = canvas.getContext('2d');
    ctx.drawImage(img, 0, 0, width, height);
    callback(canvas.toDataURL('image/jpeg', 0.72));
  };
  img.src = dataUrl;
}

/* ---------- Modal open/close/save ---------- */
function openAddModal(){
  editingId = null;
  currentPhotoData = null;
  document.getElementById('modalTitle').textContent = activeView === 'wishlist' ? 'Ajouter à la liste de souhaits' : 'Ajouter une carte';
  document.getElementById('fPlayer').value = '';
  document.getElementById('fTeam').value = '';
  document.getElementById('fSport').value = 'Football';
  document.getElementById('fSet').value = '';
  document.getElementById('fCardNum').value = '';
  document.getElementById('fNumbering').value = '';
  document.getElementById('fAuto').checked = false;
  document.getElementById('fValue').value = '';
  document.getElementById('fNotes').value = '';
  document.getElementById('fStatus').value = activeView;
  updateValueLabel();
  renderDropzone();
  document.getElementById('overlay').classList.add('open');
  document.getElementById('fPlayer').focus();
}

async function openEdit(id){
  const c = cards.find(x=>x.id === id);
  if(!c) return;
  editingId = id;
  currentPhotoData = null;
  document.getElementById('modalTitle').textContent = 'Modifier la carte';
  document.getElementById('fPlayer').value = c.player || '';
  document.getElementById('fTeam').value = c.team || '';
  document.getElementById('fSport').value = c.sport || 'Football';
  document.getElementById('fSet').value = c.set || '';
  document.getElementById('fCardNum').value = c.cardNum || '';
  document.getElementById('fNumbering').value = c.numbering || '';
  document.getElementById('fAuto').checked = !!c.auto;
  document.getElementById('fValue').value = c.value || '';
  document.getElementById('fNotes').value = c.notes || '';
  document.getElementById('fStatus').value = c.wishlist ? 'wishlist' : 'collection';
  updateValueLabel();

  if(c.hasPhoto){
    try{
      const result = await window.storage.get(photoKey(id), false);
      if(result) currentPhotoData = result.value;
    }catch(e){}
  }
  renderDropzone();
  document.getElementById('overlay').classList.add('open');
}

function closeModal(){
  document.getElementById('overlay').classList.remove('open');
  currentPhotoData = null;
}

async function saveCard(){
  const player = document.getElementById('fPlayer').value.trim();
  if(!player){
    showToast('Le nom du joueur est obligatoire.');
    return;
  }
  const saveBtn = document.getElementById('saveCard');
  saveBtn.disabled = true;
  saveBtn.textContent = 'Enregistrement...';

  const data = {
    player,
    team: document.getElementById('fTeam').value.trim(),
    sport: document.getElementById('fSport').value,
    set: document.getElementById('fSet').value.trim(),
    cardNum: document.getElementById('fCardNum').value.trim(),
    numbering: document.getElementById('fNumbering').value.trim(),
    auto: document.getElementById('fAuto').checked,
    value: document.getElementById('fValue').value.trim(),
    notes: document.getElementById('fNotes').value.trim(),
    hasPhoto: !!currentPhotoData,
    wishlist: document.getElementById('fStatus').value === 'wishlist'
  };

  let id = editingId;
  try{
    if(id){
      const idx = cards.findIndex(c=>c.id === id);
      if(idx > -1) cards[idx] = { ...cards[idx], ...data };
    } else {
      id = 'card-' + Date.now();
      data.id = id;
      cards.unshift(data);
    }

    if(currentPhotoData){
      await window.storage.set(photoKey(id), currentPhotoData, false);
    }

    await persistMeta();
    showToast(editingId ? 'Carte mise à jour.' : 'Carte ajoutée au classeur.');
    closeModal();
    render();
  }catch(e){
    showToast('Erreur pendant la sauvegarde, réessaie.');
  }finally{
    saveBtn.disabled = false;
    saveBtn.textContent = 'Enregistrer';
  }
}

async function deleteCard(id){
  cards = cards.filter(c=>c.id !== id);
  await persistMeta();
  try{ await window.storage.delete(photoKey(id), false); }catch(e){}
  render();
  showToast('Carte supprimée.');
}

function updateValueLabel(){
  const isWishlist = document.getElementById('fStatus').value === 'wishlist';
  document.getElementById('valueLabel').textContent = isWishlist ? 'Budget cible (€)' : 'Valeur estimée (€)';
}

document.getElementById('openAdd').addEventListener('click', openAddModal);
document.getElementById('cancelAdd').addEventListener('click', closeModal);
document.getElementById('saveCard').addEventListener('click', saveCard);
document.getElementById('fStatus').addEventListener('change', updateValueLabel);
document.getElementById('tabCollection').addEventListener('click', ()=> switchView('collection'));
document.getElementById('tabWishlist').addEventListener('click', ()=> switchView('wishlist'));
document.getElementById('overlay').addEventListener('click', (e)=>{
  if(e.target.id === 'overlay') closeModal();
});
document.getElementById('filterSport').addEventListener('change', render);
document.getElementById('filterAuto').addEventListener('change', render);
document.getElementById('search').addEventListener('input', render);

loadCards();
