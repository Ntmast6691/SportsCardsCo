<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Le Classeur — Collection Topps</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap');

  :root{
    --bg: #0a0c10;
    --bg-raised: #12151c;
    --slot: #171b23;
    --slot-border: #262b36;
    --ink: #eae7df;
    --ink-dim: #8b909c;
    --gold: #c9a84c;
    --holo-a: #6ee7ff;
    --holo-b: #ff8fe0;
    --holo-c: #9dff8f;
    --danger: #e0654f;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:
      radial-gradient(ellipse 80% 50% at 50% -10%, #1a1f2c 0%, transparent 60%),
      var(--bg);
    color:var(--ink);
    font-family:'Space Grotesk', sans-serif;
    min-height:100vh;
    padding-bottom:80px;
  }

  header{
    padding:48px 24px 28px;
    text-align:center;
    position:relative;
    overflow:hidden;
  }
  header::before{
    content:"";
    position:absolute;
    top:0; left:0; right:0; height:2px;
    background:linear-gradient(90deg, transparent, var(--holo-a), var(--holo-b), var(--holo-c), transparent);
    opacity:.8;
  }
  .eyebrow{
    font-family:'JetBrains Mono', monospace;
    font-size:11px;
    letter-spacing:.25em;
    text-transform:uppercase;
    color:var(--ink-dim);
    margin-bottom:10px;
  }
  h1{
    font-family:'Bebas Neue', sans-serif;
    font-size:clamp(40px, 8vw, 72px);
    letter-spacing:.03em;
    margin:0;
    line-height:.95;
    background:linear-gradient(100deg, var(--ink) 40%, var(--holo-a) 48%, var(--holo-b) 55%, var(--ink) 65%);
    background-size:250% 100%;
    -webkit-background-clip:text;
    background-clip:text;
    -webkit-text-fill-color:transparent;
    animation: sheen 7s ease-in-out infinite;
  }
  @keyframes sheen{
    0%,100%{background-position:0% 0;}
    50%{background-position:100% 0;}
  }
  .sub{
    color:var(--ink-dim);
    font-size:14px;
    margin-top:10px;
  }

  .tabs{
    max-width:900px;
    margin:0 auto;
    display:flex;
    justify-content:center;
    gap:6px;
    padding:0 24px;
  }
  .tab{
    background:transparent;
    border:1px solid var(--slot-border);
    color:var(--ink-dim);
    padding:9px 20px;
    border-radius:999px;
    font-family:'Space Grotesk', sans-serif;
    font-size:13px;
    font-weight:500;
    cursor:pointer;
    transition:all .2s ease;
  }
  .tab:hover{color:var(--ink); border-color:#3a4152;}
  .tab.active{
    background:linear-gradient(120deg, var(--holo-a), var(--holo-b));
    color:#0a0c10;
    border-color:transparent;
    font-weight:600;
  }

  .stats{
    max-width:900px;
    margin:28px auto 0;
    display:flex;
    justify-content:center;
    gap:0;
    flex-wrap:wrap;
    border:1px solid var(--slot-border);
    border-radius:14px;
    overflow:hidden;
    background:var(--bg-raised);
  }
  .stat{
    flex:1;
    min-width:120px;
    padding:16px 12px;
    text-align:center;
    border-right:1px solid var(--slot-border);
  }
  .stat:last-child{border-right:none;}
  .stat .num{
    font-family:'Bebas Neue', sans-serif;
    font-size:28px;
    color:var(--gold);
    letter-spacing:.02em;
  }
  .stat .label{
    font-size:10px;
    text-transform:uppercase;
    letter-spacing:.15em;
    color:var(--ink-dim);
    margin-top:2px;
  }

  .toolbar{
    max-width:1100px;
    margin:32px auto 0;
    padding:0 24px;
    display:flex;
    gap:12px;
    flex-wrap:wrap;
    align-items:center;
    justify-content:space-between;
  }
  .filters{
    display:flex;
    gap:8px;
    flex-wrap:wrap;
  }
  select, input[type="text"].search{
    background:var(--slot);
    border:1px solid var(--slot-border);
    color:var(--ink);
    padding:9px 12px;
    border-radius:8px;
    font-family:'Space Grotesk', sans-serif;
    font-size:13px;
  }
  select:focus, input:focus{outline:1px solid var(--holo-a);}

  .add-btn{
    background:linear-gradient(120deg, var(--holo-a), var(--holo-b));
    color:#0a0c10;
    border:none;
    padding:11px 20px;
    border-radius:8px;
    font-family:'Space Grotesk', sans-serif;
    font-weight:600;
    font-size:14px;
    cursor:pointer;
    transition:transform .15s ease, box-shadow .15s ease;
  }
  .add-btn:hover{transform:translateY(-1px); box-shadow:0 6px 18px -6px rgba(110,231,255,.5);}
  .add-btn:active{transform:translateY(0);}

  .binder{
    max-width:1100px;
    margin:24px auto;
    padding:0 24px;
    display:grid;
    grid-template-columns:repeat(auto-fill, minmax(200px, 1fr));
    gap:18px;
  }

  .slot{
    position:relative;
    background:var(--slot);
    border:1px solid var(--slot-border);
    border-radius:14px;
    aspect-ratio: 5 / 7;
    overflow:hidden;
    display:flex;
    flex-direction:column;
    justify-content:space-between;
    padding:14px;
    transition:border-color .2s ease, transform .2s ease;
    cursor:pointer;
  }
  .slot:hover{border-color:#3a4152; transform:translateY(-2px);}

  .slot.has-photo{padding:0;}
  .slot .photo-bg{
    position:absolute; inset:0;
    background-size:cover;
    background-position:center;
    z-index:0;
  }
  .slot .photo-scrim{
    position:absolute; inset:0;
    background:linear-gradient(to top, rgba(6,7,10,.92) 0%, rgba(6,7,10,.55) 32%, rgba(6,7,10,0) 55%, rgba(6,7,10,.35) 100%);
    z-index:1;
  }
  .slot.has-photo .top-row, .slot.has-photo .body, .slot.has-photo .bottom-row{
    position:relative; z-index:2;
  }
  .slot.has-photo{padding:14px;}

  .slot::after{
    content:"";
    position:absolute;
    inset:0;
    background:linear-gradient(115deg, transparent 30%, rgba(110,231,255,.10) 45%, rgba(255,143,224,.10) 55%, transparent 70%);
    background-size:250% 250%;
    background-position:-100% -100%;
    pointer-events:none;
    transition:background-position .6s ease;
    z-index:3;
  }
  .slot:hover::after{background-position:100% 100%;}

  .slot .top-row{
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
    position:relative;
    z-index:1;
  }
  .badge{
    font-family:'JetBrains Mono', monospace;
    font-size:10px;
    padding:3px 7px;
    border-radius:5px;
    text-transform:uppercase;
    letter-spacing:.05em;
  }
  .badge.auto{background:rgba(201,168,76,.18); color:var(--gold); border:1px solid rgba(201,168,76,.4);}
  .badge.sport{background:rgba(255,255,255,.08); color:var(--ink-dim); border:1px solid rgba(255,255,255,.12);}
  .badge.wish{background:rgba(255,143,224,.16); color:var(--holo-b); border:1px solid rgba(255,143,224,.4);}

  .move-btn{
    width:100%;
    margin-top:8px;
    background:rgba(157,255,143,.12);
    border:1px solid rgba(157,255,143,.35);
    color:var(--holo-c);
    padding:7px 10px;
    border-radius:7px;
    font-family:'Space Grotesk', sans-serif;
    font-size:11px;
    font-weight:600;
    cursor:pointer;
    position:relative;
    z-index:2;
  }
  .move-btn:hover{background:rgba(157,255,143,.22);}

  .del{
    background:rgba(0,0,0,.3); border:none; color:var(--ink-dim); cursor:pointer;
    font-size:16px; line-height:1; padding:2px 6px; border-radius:6px;
  }
  .del:hover{color:var(--danger); background:rgba(224,101,79,.15);}

  .slot .body{position:relative; z-index:1;}
  .player{
    font-family:'Bebas Neue', sans-serif;
    font-size:22px;
    letter-spacing:.01em;
    line-height:1.05;
    margin-bottom:4px;
  }
  .team{
    font-size:11px;
    color:var(--ink-dim);
    margin-bottom:10px;
  }
  .setline{
    font-size:11px;
    color:var(--ink-dim);
    line-height:1.5;
  }
  .setline b{color:var(--ink); font-weight:500;}
  .numbering{
    font-family:'JetBrains Mono', monospace;
    font-size:11px;
    color:var(--holo-a);
    margin-top:6px;
  }

  .slot .bottom-row{
    position:relative; z-index:1;
    display:flex;
    justify-content:space-between;
    align-items:flex-end;
  }
  .value{
    font-family:'Bebas Neue', sans-serif;
    font-size:20px;
    color:var(--gold);
  }
  .value .cur{font-size:12px; color:var(--ink-dim); font-family:'Space Grotesk';}
  .cardnum{
    font-family:'JetBrains Mono', monospace;
    font-size:10px;
    color:var(--ink-dim);
  }

  .add-slot{
    border:1.5px dashed var(--slot-border);
    background:transparent;
    display:flex;
    align-items:center;
    justify-content:center;
    flex-direction:column;
    gap:6px;
    cursor:pointer;
    color:var(--ink-dim);
    transition:border-color .2s ease, color .2s ease;
  }
  .add-slot:hover{border-color:var(--holo-a); color:var(--holo-a);}
  .add-slot .plus{font-size:32px; font-family:'Bebas Neue'; line-height:1;}
  .add-slot .txt{font-size:11px; text-transform:uppercase; letter-spacing:.1em;}

  .empty-state{
    max-width:500px;
    margin:60px auto;
    text-align:center;
    color:var(--ink-dim);
    padding:0 24px;
  }
  .empty-state .plus{font-size:40px; color:var(--holo-a); font-family:'Bebas Neue';}

  .overlay{
    position:fixed; inset:0;
    background:rgba(5,6,9,.75);
    backdrop-filter:blur(4px);
    display:none;
    align-items:center;
    justify-content:center;
    z-index:100;
    padding:20px;
  }
  .overlay.open{display:flex;}
  .modal{
    background:var(--bg-raised);
    border:1px solid var(--slot-border);
    border-radius:16px;
    width:100%;
    max-width:480px;
    max-height:90vh;
    overflow-y:auto;
    padding:28px;
  }
  .modal h2{
    font-family:'Bebas Neue', sans-serif;
    font-size:26px;
    margin:0 0 18px;
    letter-spacing:.02em;
  }
  .field{margin-bottom:14px;}
  .field label{
    display:block;
    font-size:11px;
    text-transform:uppercase;
    letter-spacing:.1em;
    color:var(--ink-dim);
    margin-bottom:6px;
  }
  .field input, .field select, .field textarea{
    width:100%;
    background:var(--slot);
    border:1px solid var(--slot-border);
    color:var(--ink);
    padding:10px 12px;
    border-radius:8px;
    font-family:'Space Grotesk', sans-serif;
    font-size:14px;
  }
  .field textarea{resize:vertical; min-height:60px; font-family:'JetBrains Mono', monospace; font-size:12px;}
  .row2{display:grid; grid-template-columns:1fr 1fr; gap:12px;}
  .modal-actions{
    display:flex;
    gap:10px;
    margin-top:20px;
  }
  .btn-primary{
    flex:1;
    background:linear-gradient(120deg, var(--holo-a), var(--holo-b));
    color:#0a0c10;
    border:none;
    padding:12px;
    border-radius:8px;
    font-weight:600;
    font-size:14px;
    cursor:pointer;
  }
  .btn-primary:disabled{opacity:.5; cursor:not-allowed;}
  .btn-secondary{
    background:none;
    border:1px solid var(--slot-border);
    color:var(--ink-dim);
    padding:12px 18px;
    border-radius:8px;
    font-size:14px;
    cursor:pointer;
  }
  .btn-secondary:hover{color:var(--ink);}
  .checkbox-row{
    display:flex;
    align-items:center;
    gap:8px;
    margin-bottom:14px;
  }
  .checkbox-row input{width:auto;}
  .checkbox-row label{margin:0; text-transform:none; letter-spacing:0; font-size:13px; color:var(--ink);}

  /* Photo dropzone */
  .dropzone{
    border:1.5px dashed var(--slot-border);
    border-radius:10px;
    padding:16px;
    text-align:center;
    cursor:pointer;
    transition:border-color .2s ease, background .2s ease;
    position:relative;
    min-height:120px;
    display:flex;
    align-items:center;
    justify-content:center;
    flex-direction:column;
    gap:6px;
    background:rgba(255,255,255,.02);
  }
  .dropzone.drag{border-color:var(--holo-a); background:rgba(110,231,255,.06);}
  .dropzone .icon{font-size:22px; color:var(--ink-dim);}
  .dropzone .txt{font-size:12px; color:var(--ink-dim);}
  .dropzone .txt b{color:var(--holo-a); font-weight:600;}
  .dropzone input[type=file]{
    position:absolute; inset:0; opacity:0; cursor:pointer;
  }
  .preview-wrap{
    position:relative;
    display:inline-block;
  }
  .preview-wrap img{
    max-width:100%;
    max-height:220px;
    border-radius:10px;
    display:block;
  }
  .preview-remove{
    position:absolute;
    top:8px; right:8px;
    background:rgba(6,7,10,.75);
    color:var(--ink);
    border:none;
    width:26px; height:26px;
    border-radius:50%;
    cursor:pointer;
    font-size:14px;
  }
  .preview-remove:hover{background:rgba(224,101,79,.85);}

  #toast{
    position:fixed;
    bottom:24px;
    left:50%;
    transform:translateX(-50%) translateY(20px);
    background:var(--slot);
    border:1px solid var(--slot-border);
    padding:12px 20px;
    border-radius:10px;
    font-size:13px;
    opacity:0;
    transition:opacity .25s ease, transform .25s ease;
    pointer-events:none;
    z-index:200;
    max-width:80vw;
    text-align:center;
  }
  #toast.show{opacity:1; transform:translateX(-50%) translateY(0);}

  @media (max-width:520px){
    .row2{grid-template-columns:1fr;}
    .binder{grid-template-columns:repeat(auto-fill, minmax(150px,1fr));}
  }
</style>
</head>
<body>

<header>
  <div class="eyebrow">Perpignan · Topps</div>
  <h1>LE CLASSEUR</h1>
  <div class="sub">Ta collection de cartes, page par page.</div>
</header>

<div class="tabs" id="tabs">
  <button class="tab active" data-view="collection" id="tabCollection">Ma collection</button>
  <button class="tab" data-view="wishlist" id="tabWishlist">Liste de souhaits</button>
</div>

<div class="stats" id="stats"></div>

<div class="toolbar">
  <div class="filters">
    <select id="filterSport">
      <option value="">Tous les sports</option>
      <option value="Football">Football</option>
      <option value="Basketball">Basketball</option>
      <option value="Autre">Autre</option>
    </select>
    <select id="filterAuto">
      <option value="">Auto / non-auto</option>
      <option value="oui">Autographiées</option>
      <option value="non">Non autographiées</option>
    </select>
    <input type="text" class="search" id="search" placeholder="Rechercher un joueur...">
  </div>
  <button class="add-btn" id="openAdd">+ Ajouter une carte</button>
</div>

<div class="binder" id="binder"></div>
<div class="empty-state" id="emptyState" style="display:none;">
  <div class="plus">+</div>
  <p>Ton classeur est vide pour l'instant.<br>Ajoute ta première carte pour commencer.</p>
</div>

<div id="toast"></div>

<!-- Modal -->
<div class="overlay" id="overlay">
  <div class="modal">
    <h2 id="modalTitle">Ajouter une carte</h2>
    <input type="hidden" id="editId">

    <div class="field">
      <label>Statut</label>
      <select id="fStatus">
        <option value="collection">Dans ma collection</option>
        <option value="wishlist">Sur ma liste de souhaits</option>
      </select>
    </div>

    <div class="field">
      <label>Photo de la carte</label>
      <div id="dropzoneWrap"></div>
    </div>

    <div class="field">
      <label>Joueur *</label>
      <input type="text" id="fPlayer" placeholder="ex. Gonçalo Ramos">
    </div>
    <div class="row2">
      <div class="field">
        <label>Équipe</label>
        <input type="text" id="fTeam" placeholder="ex. PSG">
      </div>
      <div class="field">
        <label>Sport</label>
        <select id="fSport">
          <option>Football</option>
          <option>Basketball</option>
          <option>Autre</option>
        </select>
      </div>
    </div>
    <div class="field">
      <label>Set / série</label>
      <input type="text" id="fSet" placeholder="ex. Topps PSG Team Set 2025-26">
    </div>
    <div class="row2">
      <div class="field">
        <label>N° de carte</label>
        <input type="text" id="fCardNum" placeholder="ex. BB-GR">
      </div>
      <div class="field">
        <label>Numérotation</label>
        <input type="text" id="fNumbering" placeholder="ex. 70/99">
      </div>
    </div>
    <div class="checkbox-row">
      <input type="checkbox" id="fAuto">
      <label for="fAuto">Carte autographiée</label>
    </div>
    <div class="field">
      <label id="valueLabel">Valeur estimée (€)</label>
      <input type="text" id="fValue" placeholder="ex. 50">
    </div>
    <div class="field">
      <label>Notes</label>
      <textarea id="fNotes" placeholder="état, provenance, remarques..."></textarea>
    </div>
    <div class="modal-actions">
      <button class="btn-secondary" id="cancelAdd">Annuler</button>
      <button class="btn-primary" id="saveCard">Enregistrer</button>
    </div>
  </div>
</div>

<script>
const META_KEY = 'topps-cards-meta';
let cards = [];
let editingId = null;
let currentPhotoData = null; // base64 dataURL currently attached in the form
let activeView = 'collection'; // 'collection' | 'wishlist'

// Photos pré-intégrées pour les cartes de départ (envoyées dans le chat)
const seedPhotos = {
  'seed-4': 'data:image/jpeg;base64,',
  'seed-5': 'data:image/jpeg;base64,',
  'seed-6': 'data:image/jpeg;base64,'
};

const seed = [
  { id: 'seed-1', player: 'Jalen Brunson', team: 'New York Knicks', sport: 'Basketball',
    set: 'Topps Signature Class — Aristocrats', cardNum: 'AR-11', numbering: '', auto: false,
    value: '140', notes: 'Insert SSP Case Hit. Ventes conclues sur 130point : 151,21€ et 129,60€ (juin 2026).', hasPhoto: false, wishlist: false },
