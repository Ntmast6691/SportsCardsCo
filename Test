    set: 'Topps PSG Team Set 2025-26 — Bona Fide Baller', cardNum: 'BB-GR', numbering: '70/99',
    auto: true, value: '30', notes: 'Green Rainbow Foil, autographe certifié Topps. Estimation basée sur des cartes comparables du set.', hasPhoto: false, wishlist: false },
  { id: 'seed-3', player: 'Rodrigo Mora', team: 'FC Porto', sport: 'Football',
    set: 'Topps Chrome UEFA Club Competitions — Future Flare', cardNum: '', numbering: '',
    auto: true, value: '25', notes: 'Rookie auto, à vérifier la numérotation exacte au dos. Estimation basée sur des ventes comparables.', hasPhoto: false, wishlist: false },
  { id: 'seed-4', player: 'Brennan Johnson', team: 'Tottenham Hotspur', sport: 'Football',
    set: 'Topps Chrome UEFA Champions League — Blue Refractor', cardNum: '', numbering: '016/150',
    auto: true, value: '20', notes: 'Autographe certifié Topps, parallèle Blue Refractor. Estimation basée sur des ventes comparables.', hasPhoto: true, wishlist: false },
  { id: 'seed-5', player: 'Frank Ntilikina', team: 'New York Knicks', sport: 'Basketball',
    set: 'Panini National Treasures — Colossal Rookie Materials', cardNum: '', numbering: '25/25',
    auto: false, value: '18', notes: 'Patch rookie, carte Panini (pas Topps). Joueur de rotation, valeur modeste.', hasPhoto: true, wishlist: false },
  { id: 'seed-6', player: 'Pacôme Dadiet', team: 'New York Knicks', sport: 'Basketball',
    set: 'Panini Mosaic — Rookie Patch Autograph', cardNum: '', numbering: '',
    auto: true, value: '40', notes: 'Patch tricolore + autographe certifié, carte Panini (pas Topps). Fourchette large (5-60€) selon le parallèle exact.', hasPhoto: true, wishlist: false }
];

// Liste de souhaits PSG demandée par Thibault — autographe OU relic (pas forcément les 2)
// Valeurs par catégorie de notoriété (pas de vente vérifiée individuellement pour chaque carte)
const wishlistSeed = [
  { id: 'wish-donnarumma', player: 'Gianluigi Donnarumma', value: '80', note: 'Superstar confirmé (gardien n°1 PSG).' },
  { id: 'wish-hakimi', player: 'Achraf Hakimi', value: '80', note: 'Superstar confirmé.' },
  { id: 'wish-marquinhos', player: 'Marquinhos', value: '45', note: 'Cadre historique du PSG, capitaine.' },
  { id: 'wish-pacho', player: 'Willian Pacho', value: '25', note: 'Jeune titulaire, marché encore modeste.' },
  { id: 'wish-nunomendes', player: 'Nuno Mendes', value: '45', note: 'Cadre confirmé du PSG.' },
  { id: 'wish-vitinha', player: 'Vitinha', value: '80', note: 'Superstar confirmé.' },
  { id: 'wish-joaoneves', player: 'João Neves', value: '45', note: 'Jeune cadre déjà très suivi.' },
  { id: 'wish-zaireemery', player: 'Warren Zaïre-Emery', value: '45', note: 'Pépite formée au club, forte cote en France.' },
